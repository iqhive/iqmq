# Row B9: receive storage and iteration (x/apibench/b9). See hack/bakeoff.sh.
PKG=./x/apibench/b9
BENCH=BenchmarkReceive
REF=pointer
AUTO_KEY=b9
# the benchmark configuration: this row is one of the MUTUALLY EXCLUSIVE API shapes.
# Only one shape can be the API, so a shape the API did not take is a loser
# in §9.4(5)'s sense and cannot be retained as a profile the way a §9.1 arm
# can.
CLASS=B
#
# `git worktree add <path> d802b9e4e8c9` restores every shape this row
# measured, which is what makes a re-ratification on a pinned host still
# possible.
REMOVED=retired
ADR=6
TITLE="Receive storage and iteration: slice of pointers, slice of values, Seq2, cursor, channel (B9)"
# All five shapes carry the same delivery (b1.Delivery) over the same broker
# and the same settlement representation, so ns/msg and allocs/msg compare the
# storage and the iteration alone. The safe mode is where a batch's storage is
# allocated and the shapes differ in how much; the reuse mode is where they all
# reach zero and only the iteration is left, which is why the benchmark carries
# the mode as a dimension. The DX half is the line counts logged by TestTasks.

#
# CRITERION is the benchmark configuration's decision column for this row, quoted.
# MATRIX is the IQMQ_BENCH_MATRIX grid the campaign measures the family at.
# DECIDED_AT names the benchmark-name segments the criterion is read at, and
# DECIDED_ON the metrics; `make bench-lint` lists the family's benchmarks at
# the declared grid and fails when a term or a metric is missing from the rows
# every kind has in common, which is the only data `bakeoff decide` reads.
CRITERION="'[]*Delivery' + 'Seq2' unless measurable cost (overhead vs Receive; GC pressure at batch 1/10/100/1000)"
# MATRIX=default is the only grid, and it is the criterion's: §9.2 names
# batch 1/10/100/1000 and all four are present, at both the safe and the reuse
# ownership modes.
MATRIX=default
DECIDED_AT="Batch=1 Batch=10 Batch=100 Batch=1000 mode=safe mode=reuse"
DECIDED_ON="ns/op allocs/op"
