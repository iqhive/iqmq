# Row B8: codec interface shape (x/apibench/b8). See hack/bakeoff.sh.
PKG=./x/apibench/b8
BENCH=BenchmarkAPIBench/B8
REF=iface
AUTO_KEY=b8
# the benchmark configuration: this row is one of the MUTUALLY EXCLUSIVE API shapes.
# Only one shape can be the API, so a shape the API did not take is a loser
# in §9.4(5)'s sense and cannot be retained as a profile the way a §9.1 arm
# can.
CLASS=B
#
# `git worktree add <path> d802b9e4e8c9` restores every shape this row
# measured, which is what makes a re-ratification on a pinned host still
# possible.
REMOVED=retired
# ADR-006 collects the API-surface rows B3-B5, B8, B9, B11 and B12. The plan's
# A24 row does not name B8; this file has said ADR-006 since the row was built
# and that is what A24 binds (adr/ADR-017-assumptions.md).
ADR=6
TITLE="Codec interface shape: interface, generic and Marshaler hooks (B8)"
# The three shapes encode the same message with the same encoder, so ns/op
# compares the shapes and not the JSON implementation. allocs/op is the
# headline number: the hook shape encodes into the caller's buffer with none.

#
# CRITERION is the benchmark configuration's decision column for this row, quoted.
# MATRIX is the IQMQ_BENCH_MATRIX grid the campaign measures the family at.
# DECIDED_AT names the benchmark-name segments the criterion is read at, and
# DECIDED_ON the metrics; `make bench-lint` lists the family's benchmarks at
# the declared grid and fails when a term or a metric is missing from the rows
# every kind has in common, which is the only data `bakeoff decide` reads.
CRITERION="both; 'typed' accepts either (allocs per encode/decode; ergonomics with typed)"
# MATRIX=default is the only grid: x/apibench/b8 has no IQMQ_BENCH_MATRIX
# branch, and its nine rows per kind cross marshal and unmarshal with §10.4's
# payload sizes and the caller-buffer discipline the allocation claim rests
# on.
MATRIX=default
DECIDED_AT="Marshal Unmarshal 64B 1KiB 64KiB buf=fresh buf=reuse"
DECIDED_ON="ns/op allocs/op"
