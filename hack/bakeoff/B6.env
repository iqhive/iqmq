# Row B6: top-level API shape (x/apibench/b6). See hack/bakeoff.sh.
PKG=./x/apibench/b6
BENCH=BenchmarkAPIBench/B6
REF=concrete
AUTO_KEY=b6
# the benchmark configuration: this row is one of the MUTUALLY EXCLUSIVE API shapes.
# Only one shape can be the API, so a shape the API did not take is a loser
# in §9.4(5)'s sense and cannot be retained as a profile the way a §9.1 arm
# can.
CLASS=B
#
# `git worktree add <path> d802b9e4e8c9` restores every shape this row
# measured, which is what makes a re-ratification on a pinned host still
# possible.
REMOVED=retired
ADR=3
TITLE="Top-level types: concrete handles, narrow interfaces, or the driver's own API (B6)"
# The benchmark is BenchmarkAPIBench/B6 and not §10.5's BenchmarkAPI/Dispatch:
# A19 took that name for the engine's lane binding (family A26), which
# benchmarks/budgets.yaml gates, and recorded that a later B6 prototype takes an
# APIBench name as B8 does (adr/ADR-017-assumptions.md).
#
# The Interface shape's session holds the Concrete shape's own *Client behind
# the API's and §5.5's narrow interfaces, so the two shapes execute
# the same instructions and the difference between their ns/op is the dispatch
# and nothing else — which is what "dispatch benchmark" has to mean.
#
# The Direct arm is §10.5's "native": no handle, no delivery type, no
# settlement representation. It deliberately does LESS, and that is what it
# measures — the cost of having a portable layer at all — so its numbers are a
# baseline and not a sibling's (adr/ADR-017-assumptions.md). §10.5 spells the
# arm "native" and the plan spells it "direct"; the plan's slug is used.
#
# The other half of §9.2's evidence for the row is the API-evolution review,
# and TestEvolution settles the two claims a compiler can: a third party can
# implement the narrow interface and cannot implement the concrete handle, and
# the Direct arm's caller names the driver's own types. The three answers are
# not orderable — the interface buys implementability with method-addition
# compatibility — which is why §9.2's tentative answer ships both.

#
# CRITERION is the benchmark configuration's decision column for this row, quoted.
# MATRIX is the IQMQ_BENCH_MATRIX grid the campaign measures the family at.
# DECIDED_AT names the benchmark-name segments the criterion is read at, and
# DECIDED_ON the metrics; `make bench-lint` lists the family's benchmarks at
# the declared grid and fails when a term or a metric is missing from the rows
# every kind has in common, which is the only data `bakeoff decide` reads.
CRITERION="concrete handles implementing narrow interfaces (dispatch benchmark, negligible expected)"
# MATRIX=default is the only grid: x/apibench/b6 has no IQMQ_BENCH_MATRIX
# branch, and four rows per kind (two ownership modes at the batch ends) are
# what a dispatch cost expected to be negligible needs.
MATRIX=default
DECIDED_AT="safe reuse batch=1 batch=100"
DECIDED_ON="ns/op allocs/op"
# The `direct` arm is §10.5's "native" baseline -- no handle, no delivery
# type, no settlement -- and reading it as a sibling's result would read the
# absence of a feature as a cheaper implementation of it.
