# Row B1: received-message shape (x/apibench/b1). See hack/bakeoff.sh.
PKG=./x/apibench/b1
BENCH=BenchmarkAPIBench/B1
REF=delivptr
AUTO_KEY=b1
# the benchmark configuration: this row is one of the MUTUALLY EXCLUSIVE API shapes.
# Only one shape can be the API, so a shape the API did not take is a loser
# in §9.4(5)'s sense and cannot be retained as a profile the way a §9.1 arm
# can.
CLASS=B
#
# `git worktree add <path> d802b9e4e8c9` restores every shape this row
# measured, which is what makes a re-ratification on a pinned host still
# possible.
REMOVED=retired
ADR=5
TITLE="Received-message shape: separate Delivery, embedded value, unified message (B1)"
# The three shapes run the identical publish-consume-settle round over the
# identical broker (x/apibench/harness.RunBench), so ns/msg compares the shape
# and not the engine. allocs/msg is the second headline: the value shape keeps
# a batch in one backing array, which is one allocation per delivery fewer than
# the two pointer shapes in the safe mode, and all three reach zero in the
# reuse mode. The DX half of the row is the line counts logged by TestTasks and
# the misuse scores logged by TestMisuse.

#
# CRITERION is the benchmark configuration's decision column for this row, quoted.
# MATRIX is the IQMQ_BENCH_MATRIX grid the campaign measures the family at.
# DECIDED_AT names the benchmark-name segments the criterion is read at, and
# DECIDED_ON the metrics; `make bench-lint` lists the family's benchmarks at
# the declared grid and fails when a term or a metric is missing from the rows
# every kind has in common, which is the only data `bakeoff decide` reads.
CRITERION="separate 'Delivery' (end-to-end memory 1P/1C allocs/op & ns/op; misuse tests; usability study)"
# MATRIX=default is the only grid: x/apibench/b1 has no IQMQ_BENCH_MATRIX
# branch. Its twelve rows per shape cross the settlement representations of
# row B2 with the safe and reuse ownership modes and §10.4's batch ends,
# which is where a pointer delivery and a value delivery differ.
MATRIX=default
DECIDED_AT="settle=token settle=closure settle=object safe reuse batch=1 batch=100"
DECIDED_ON="allocs/op ns/op"
# The usability half of §9.2's evidence -- lines to consume and ack -- is not
# a benchmark metric; x/apibench/scoring's scorecard.json carries it.
CRITERION_GAP="consume-ack-lines=x/apibench/scoring scorecard.json, written by 'make scorecard SCORECARD=<path>'"
