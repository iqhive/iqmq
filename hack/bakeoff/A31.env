# Family A31: request/reply correlation stores (internal/corr). See hack/bakeoff.sh.
PKG=./internal/corr
BENCH=BenchmarkReqReply/Store
REF=sharded
AUTO_KEY=corr
ADR=20
TITLE="Request/reply correlation storage (A31)"
# Full profile: IQMQ_BENCH_MATRIX=full sweeps P=1,4,8,32 and pending=1..8192.
# BenchmarkReqReply/Sweep/<kind>/pending= measures the expiry pass separately;
# it is reported in the ADR, not part of the geomean.

#
# CRITERION is the benchmark configuration's decision column for this row, quoted.
# MATRIX is the IQMQ_BENCH_MATRIX grid the campaign measures the family at.
# DECIDED_AT names the benchmark-name segments the criterion is read at, and
# DECIDED_ON the metrics; `make bench-lint` lists the family's benchmarks at
# the declared grid and fails when a term or a metric is missing from the rows
# every kind has in common, which is the only data `bakeoff decide` reads.
CRITERION="ns/op under contention; simpler wins ties"
# MATRIX=full because both of this row's dimensions are the criterion's:
# §9.1's evidence names "request counts", which is the outstanding-request
# depth, and the smoke grid takes two of its four orders of magnitude and
# stops at P=8 for a criterion written about contention. `full` sweeps
# P{1,8,32} x pending{1,64,1024,8192}: 12 rows per kind, 36 for the family,
# 24 minutes. P=4 is dropped because the harness sweeps GOMAXPROCS=1,4,8,32
# on every row.
MATRIX=full
DECIDED_AT="P=1 P=32 pending=1 pending=1024 pending=8192"
DECIDED_ON="ns/op allocs/op"
