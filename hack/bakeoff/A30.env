# Family A30: middleware chain dispatch (internal/mwchain). See hack/bakeoff.sh.
PKG=./internal/mwchain
BENCH=BenchmarkMiddleware
REF=closure
AUTO_KEY=mwchain
ADR=17
TITLE="Middleware chain dispatch (A30)"
# The budget is §10.2: five no-op middlewares in at most 30 ns with zero
# allocations. The n=*/disabled arms are the cost of a middleware nobody
# enabled and must be indistinguishable from a bare handler call.
# BenchmarkMiddlewareCompose is the once-per-Run cost and is not scored.

#
# CRITERION is the benchmark configuration's decision column for this row, quoted.
# MATRIX is the IQMQ_BENCH_MATRIX grid the campaign measures the family at.
# DECIDED_AT names the benchmark-name segments the criterion is read at, and
# DECIDED_ON the metrics; `make bench-lint` lists the family's benchmarks at
# the declared grid and fails when a term or a metric is missing from the rows
# every kind has in common, which is the only data `bakeoff decide` reads.
CRITERION="<= 30 ns/msg, 0 allocs -> closure chain unless beaten"
# MATRIX=default because the default chain lengths {0,1,3,5} are §9.1's own
# "0-5 middlewares" and contain the five-no-op budget of §10.2 that the
# criterion IS. `full` adds the lengths at and beyond the generated chain's
# maximum (8, 9), which is a fact about the generator rather than a point any
# criterion reads.
MATRIX=default
DECIDED_AT="n=0 n=1 n=3 n=5 enabled disabled"
DECIDED_ON="ns/op allocs/op"
