# Row A37 (API-07): publisher routing (x/apibench/a37). See hack/bakeoff.sh.
PKG=./x/apibench/a37
BENCH=BenchmarkPublish
REF=bound
AUTO_KEY=a37
# the benchmark configuration: this row is one of the MUTUALLY EXCLUSIVE API shapes.
# Only one shape can be the API, so a shape the API did not take is a loser
# in §9.4(5)'s sense and cannot be retained as a profile the way a §9.1 arm
# can.
CLASS=B
#
# `git worktree add <path> d802b9e4e8c9` restores every shape this row
# measured, which is what makes a re-ratification on a pinned host still
# possible.
REMOVED=retired
ADR=21
TITLE="Publisher routing: bound publisher, topic per call, or size-bounded cache (A37)"
# All three shapes publish the identical messages to the identical topics over
# the identical broker in all three of §10.5's modes, so what the numbers
# compare is the LIFETIME of the publisher handle — the only thing a routing
# decision can change. The destination cardinality is the dimension §9.1's
# criterion turns on: topics={1, CacheSize, 4*CacheSize}.
#
# TestPublisherLifetimeIsTheShape pins the resource question as numbers: over
# 24 topics and 48 publications the bound shape holds 24 handles and builds 24,
# the per-call shape holds none and builds 48, and the cache holds 8, builds 48
# and evicts 40 — its worst case, which round-robin over three times the cache
# is. A24 reads those against the ns/op.
#
# One qualification, and it belongs to the publish mode rather than to any
# shape: an async publication is admitted by the publisher's goroutine and a
# sync one by the caller's, so two publications to one topic in different modes
# reach the lane in either order (§4.4 permits it, §5.4 says an async publish's
# context governs admission only). The scripted histories use one mode per
# topic and TestOrderIsPerModeNotPerTopic pins what survives: within one mode,
# publication order (adr/ADR-017-assumptions.md).

#
# CRITERION is the benchmark configuration's decision column for this row, quoted.
# MATRIX is the IQMQ_BENCH_MATRIX grid the campaign measures the family at.
# DECIDED_AT names the benchmark-name segments the criterion is read at, and
# DECIDED_ON the metrics; `make bench-lint` lists the family's benchmarks at
# the declared grid and fails when a term or a metric is missing from the rows
# every kind has in common, which is the only data `bakeoff decide` reads.
CRITERION="all shipped; bound recommended (stable vs high-cardinality destinations)"
# MATRIX=default is the only grid: x/apibench/a37 has no
# IQMQ_BENCH_MATRIX branch, and its nine rows per kind sweep the destination
# cardinality the criterion contrasts (one topic against 8 and 32) over the
# three publication shapes.
MATRIX=default
DECIDED_AT="topics=1 topics=8 topics=32 sync async owned"
DECIDED_ON="ns/op allocs/op"
