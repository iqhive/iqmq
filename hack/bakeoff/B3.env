# Row B3: message key type (x/apibench/b3). See hack/bakeoff.sh.
PKG=./x/apibench/b3
BENCH=BenchmarkAPIBench/B3
REF=keybytes
AUTO_KEY=b3
# the benchmark configuration: this row is one of the MUTUALLY EXCLUSIVE API shapes.
# Only one shape can be the API, so a shape the API did not take is a loser
# in §9.4(5)'s sense and cannot be retained as a profile the way a §9.1 arm
# can.
CLASS=B
#
# `git worktree add <path> d802b9e4e8c9` restores every shape this row
# measured, which is what makes a re-ratification on a pinned host still
# possible.
REMOVED=retired
ADR=6
TITLE="Message key type: []byte or string, measured at the driver boundaries (B3)"
# The measurement is the whole journey a key makes — application, engine,
# delivery, native client — because the two types are interconvertible and all
# the cost is in the conversions. TestAllocs pins the per-boundary allocation
# budget (keybytes: 0 to Kafka, 1 to SQS; keystring: 2 to Kafka, 1 to SQS) and
# TestBinaryFidelity pins that neither type loses a byte. The ownership half is
# TestKeyOwnership: a []byte key aliases the engine's storage and dies with the
# delivery, a string key owns its bytes and survives.

#
# CRITERION is the benchmark configuration's decision column for this row, quoted.
# MATRIX is the IQMQ_BENCH_MATRIX grid the campaign measures the family at.
# DECIDED_AT names the benchmark-name segments the criterion is read at, and
# DECIDED_ON the metrics; `make bench-lint` lists the family's benchmarks at
# the declared grid and fails when a term or a metric is missing from the rows
# every kind has in common, which is the only data `bakeoff decide` reads.
CRITERION="'[]byte' (conversion cost at each driver boundary; hashing; allocs; binary fidelity)"
# MATRIX=default is the only grid: x/apibench/b3 has no IQMQ_BENCH_MATRIX
# branch, and its four rows per kind are the two driver boundaries §9.2 names
# at two key lengths.
MATRIX=default
DECIDED_AT="boundary=kafka boundary=sqs keylen=8 keylen=64"
DECIDED_ON="ns/op allocs/op"
