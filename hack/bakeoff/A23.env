# Family A23: publisher batching triggers (internal/batch). See hack/bakeoff.sh.
PKG=./internal/batch
BENCH=BenchmarkBatch
REF=perbatchtimer
AUTO_KEY=batch
ADR=17
TITLE="Publisher batching trigger (A23)"
# The deciding metrics are reported per case: timers/op, batches/op,
# msgs/batch and wait-ns/op across rate= and linger= dimensions.

#
# CRITERION is the benchmark configuration's decision column for this row, quoted.
# MATRIX is the IQMQ_BENCH_MATRIX grid the campaign measures the family at.
# DECIDED_AT names the benchmark-name segments the criterion is read at, and
# DECIDED_ON the metrics; `make bench-lint` lists the family's benchmarks at
# the declared grid and fails when a term or a metric is missing from the rows
# every kind has in common, which is the only data `bakeoff decide` reads.
CRITERION="shared ticker expected (throughput vs linger; timer count; low-rate latency)"
# MATRIX=default is the only grid: internal/batch has no IQMQ_BENCH_MATRIX
# branch and its seven rows per kind cross §9.1's linger against three
# publication rates three orders of magnitude apart, which is where a
# per-batch timer and a shared ticker diverge.
MATRIX=default
DECIDED_AT="rate=100 rate=1000000 linger=1ms linger=10ms Add"
DECIDED_ON="ns/op timers/op wait-ns/op"
