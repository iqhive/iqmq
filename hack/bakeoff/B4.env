# Row B4: header representation (x/apibench/b4). See hack/bakeoff.sh.
PKG=./x/apibench/b4
BENCH=BenchmarkHeaders
REF=binaryslice
AUTO_KEY=b4
# the benchmark configuration: this row is one of the MUTUALLY EXCLUSIVE API shapes.
# Only one shape can be the API, so a shape the API did not take is a loser
# in §9.4(5)'s sense and cannot be retained as a profile the way a §9.1 arm
# can.
CLASS=B
#
# `git worktree add <path> d802b9e4e8c9` restores every shape this row
# measured, which is what makes a re-ratification on a pinned host still
# possible.
REMOVED=retired
ADR=6
TITLE="Header representation: string pairs, binary slice, map and small inline vector (B4)"
# The four representations run the identical operation over the identical
# corpus of n distinct keys, so ns/op compares the representation. allocs/op is
# the second headline and TestAllocs pins it as a table: a representation pays
# one allocation per header wherever the destination's value type differs from
# its own, which makes the engine and Kafka boundaries free for the two []byte
# shapes and the SQS boundary free for the two string shapes.
#
# The map representation cannot implement the message contract — no duplicates,
# no insertion order — so it is checked against a declared projection of the
# same model (adr/ADR-017-assumptions.md) and its Add, Values and iteration
# numbers are not comparable with the three ordered shapes. The row's finding
# for it is the lost contract, not the nanoseconds. §10.5 spells its slug
# "map" and the plan spells it "mapss"; the plan's slug is used (see
# hack/FOLLOWUPS.md for A24 to reconcile repo-wide).

#
# CRITERION is the benchmark configuration's decision column for this row, quoted.
# MATRIX is the IQMQ_BENCH_MATRIX grid the campaign measures the family at.
# DECIDED_AT names the benchmark-name segments the criterion is read at, and
# DECIDED_ON the metrics; `make bench-lint` lists the family's benchmarks at
# the declared grid and fails when a term or a metric is missing from the rows
# every kind has in common, which is the only data `bakeoff decide` reads.
CRITERION="ordered slice; value type per data (Get/Set/Add/Delete/Clone at 0-128 headers; duplicates; encode determinism; driver mapping allocs)"
# MATRIX=default is the only grid, and it is §9.2's own: five operations at
# five header counts, plus the encode, store/load and driver-mapping rows the
# evidence column asks for -- 50 rows per representation, 200 for the family,
# the third most expensive in the campaign at 2.2 h. Every one of those rows
# is named by the specification, so there is nothing here to cut; what would
# cut it is the GOMAXPROCS ladder, which for a single-goroutine header
# operation multiplies the cost by four and, because `bakeoff decide` pools
# the rungs into one median, buys sample count rather than information.
MATRIX=default
DECIDED_AT="Get Set Add Delete Clone Encode Kafka SQS n=0 n=2 n=8 n=32 n=128"
DECIDED_ON="ns/op allocs/op"
