# Row B10: error construction and matching (x/apibench/b10). See hack/bakeoff.sh.
PKG=./x/apibench/b10
BENCH=BenchmarkAPI/Errors
REF=prealloccodes
AUTO_KEY=b10
# the benchmark configuration: this row is one of the MUTUALLY EXCLUSIVE API shapes.
# Only one shape can be the API, so a shape the API did not take is a loser
# in §9.4(5)'s sense and cannot be retained as a profile the way a §9.1 arm
# can.
CLASS=B
#
# `git worktree add <path> d802b9e4e8c9` restores every shape this row
# measured, which is what makes a re-ratification on a pinned host still
# possible.
REMOVED=retired
# A24 attaches B10 to ADR-011, the failure-policy record: how an error is
# constructed and matched is the representation half of the policy ADR-011
# already states, and the plan's A24 row names no ADR for the row
# (adr/ADR-017-assumptions.md).
ADR=11
TITLE="Error construction: preallocated or per call, matched by code or by sentinel (B10)"
# All four corners run the identical fault through the identical handle, and
# TestAllocs pins the failure-path budget: preallocation buys exactly one
# allocation and only for a failure that carries no per-call context, because a
# shared value can name neither another topic nor a native cause. The
# codes-versus-sentinels axis costs nothing in allocations at all.
#
# So the row is not decided on the numbers. It is decided on three things the
# tests pin instead: what errors.Is can match — only identity matching finds a
# sentinel that carries no portable code, which is the one place the
# disciplines differ, since the message contract's rule is "errors.Is matches by
# Code"; whether a foreign helper walking the chain can discover the code at
# all (only the sentinel discipline lets it); and how many sentinels the driver
# has to own (the code discipline needs none).

#
# CRITERION is the benchmark configuration's decision column for this row, quoted.
# MATRIX is the IQMQ_BENCH_MATRIX grid the campaign measures the family at.
# DECIDED_AT names the benchmark-name segments the criterion is read at, and
# DECIDED_ON the metrics; `make bench-lint` lists the family's benchmarks at
# the declared grid and fails when a term or a metric is missing from the rows
# every kind has in common, which is the only data `bakeoff decide` reads.
CRITERION="union: codes + sentinels; preallocated hot-path errors (allocs on failure path; 'errors.Is' cost)"
# MATRIX=default is the only grid: x/apibench/b10 has no IQMQ_BENCH_MATRIX
# branch, and its twelve rows per kind cross the construction and the three
# matching calls with three fault shapes.
MATRIX=default
DECIDED_AT="Raise Is As CodeOf fault=closed fault=native fault=othertopic"
DECIDED_ON="allocs/op ns/op"
# Two of this family's four slugs are suffixes of the other two --
# `alloccodes` of `prealloccodes`, `allocsentinels` of `preallocsentinels` --
# and hack/bakeoff.sh's per-kind filter is `^<root>/<slug>(/|$)`, whose last
# element `go test` matches unanchored at the front: measured, the filter for
# `alloccodes` selects 24 benchmarks in two kinds rather than 12 in one. The
# slugs are kept, because they are what §9.2's variants column says ("
# preallocated per-handle *OpError * allocate per error; codes vs sentinels")
# and renaming a kind moves its auto binding, its model subtests and its
# scoring rows; the fix is the filter's anchoring, which belongs to
# hack/bakeoff.sh. Until it lands the campaign over-measures this family by
# about sixteen minutes and gives two of its kinds twice the samples of the
# other two, which changes no median. Assumption A24.72.
