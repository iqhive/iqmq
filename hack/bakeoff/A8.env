# Family A8: runner lane assignment and dispatch (internal/dispatch).
# See hack/bakeoff.sh.
PKG=./internal/dispatch
BENCH=BenchmarkRun/Dispatch
REF=hashlanes
AUTO_KEY=dispatch
ADR=17
TITLE="Runner lane assignment and dispatch (A8)"
# The §9 criterion is throughput under a Zipf key distribution with ordering
# preserved, which is the skew=zipf/ordered arm; skew=uniform and the keyless
# (unordered) arm are reported alongside it. BenchmarkRun/Straggler measures
# the head-of-line case a slow handler creates and is reported, not scored.
# Full profile: IQMQ_BENCH_MATRIX=full sweeps 1,2,4,8,16,64 workers.

#
# CRITERION is the benchmark configuration's decision column for this row, quoted.
# MATRIX is the IQMQ_BENCH_MATRIX grid the campaign measures the family at.
# DECIDED_AT names the benchmark-name segments the criterion is read at, and
# DECIDED_ON the metrics; `make bench-lint` lists the family's benchmarks at
# the declared grid and fails when a term or a metric is missing from the rows
# every kind has in common, which is the only data `bakeoff decide` reads.
CRITERION="throughput under Zipf with ordering preserved -> hash lanes + stealing for keyless"
# MATRIX=default because the default grid IS §9.1's: worker counts {1,8,64}
# are the row's own `{1,8,64}workers`, and both skews and both ordering modes
# are present at each. `full` adds the 2/4/16 rungs, which no criterion reads
# and which double the family's rows.
MATRIX=default
DECIDED_AT="1workers 8workers 64workers ordered unordered skew=zipf skew=uniform"
DECIDED_ON="ns/op msgs/s"
