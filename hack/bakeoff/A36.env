# Row A36 (SPI-01): batch SPI contract (x/apibench/a36). See hack/bakeoff.sh.
PKG=./x/apibench/a36
BENCH=BenchmarkAPIBench/A36
REF=optional
AUTO_KEY=a36
# the benchmark configuration: this row is one of the MUTUALLY EXCLUSIVE API shapes.
# Only one shape can be the API, so a shape the API did not take is a loser
# in §9.4(5)'s sense and cannot be retained as a profile the way a §9.1 arm
# can.
CLASS=B
#
# `git worktree add <path> d802b9e4e8c9` restores every shape this row
# measured, which is what makes a re-ratification on a pinned host still
# possible.
REMOVED=retired
ADR=21
TITLE="Batch SPI contract: optional BatchSink or mandatory batch-first (A36)"
# Both contracts publish the identical batches through the identical native
# client, so the native call counts are identical: 25 calls for a batch of 100
# over a driver with native batching and a maximum of 4, and 100 over one that
# can only send a single message. The row is therefore decided on
# the benchmark configuration's first criterion rather than its second.
#
# Third-party driver simplicity, measured (TestScore's driver.*.loc), per
# driver profile — the lines ONE driver author writes for ONE client: a driver
# of the optional contract writes 1 line with no native batching and 2 with
# it, because the core's adapter owns the loop; a driver of the batch-first
# contract writes 11 either way, the splitting or the looping being its own.
# So 11 against 2 and 11 against 1. That is the finding.
#
# "Either way" is now two driver types (batchFirstSplitDriver and
# batchFirstLoopDriver) and the two numbers coincide; the earlier figure of 23
# was one fused function counted for both profiles, which charged the contract
# about twice what any driver writes — a driver knows its own client and writes
# one arm (adr/ADR-017-assumptions.md).
#
# The correctness gate is §11.3 target 11 — index alignment and outcome
# conservation — and the corpus deliberately crosses the native maximum with
# a refusal beyond the first split, which is where a contract that aligned its
# results with the split rather than with the messages reports the wrong
# message as failed.

#
# CRITERION is the benchmark configuration's decision column for this row, quoted.
# MATRIX is the IQMQ_BENCH_MATRIX grid the campaign measures the family at.
# DECIDED_AT names the benchmark-name segments the criterion is read at, and
# DECIDED_ON the metrics; `make bench-lint` lists the family's benchmarks at
# the declared grid and fails when a term or a metric is missing from the rows
# every kind has in common, which is the only data `bakeoff decide` reads.
CRITERION="optional 'BatchSink' with driverkit adapter unless overhead material"
# MATRIX=default is the only grid: x/apibench/a36 has no
# IQMQ_BENCH_MATRIX branch, and its six rows per arm cross the two driver
# profiles §9.1 cares about (one that batches natively, one that cannot) with
# §10.4's batch sizes.
MATRIX=default
DECIDED_AT="driver=batching driver=single batch=1 batch=10 batch=100"
DECIDED_ON="ns/op allocs/op nativecalls/op"
# The half of the criterion that decides this row is not a benchmark metric
# at all: the two SPI contracts make identical native calls (nativecalls/op is
# equal by construction), so the row turns on the lines a third-party driver
# writes -- 11 against 2 for a client that batches, 11 against 1 for one that
# cannot -- which x/apibench/scoring's scorecard.json carries and
# `make scorecard` writes. Recorded in hack/FOLLOWUPS.md before this
# increment; declared here so the campaign cannot forget it.
CRITERION_GAP="driver-lines=x/apibench/scoring scorecard.json, written by 'make scorecard SCORECARD=<path>'"
