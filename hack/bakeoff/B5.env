# Row B5: publish options (x/apibench/b5). See hack/bakeoff.sh.
PKG=./x/apibench/b5
BENCH=BenchmarkAPI/Options
REF=value
AUTO_KEY=b5
# the benchmark configuration: this row is one of the MUTUALLY EXCLUSIVE API shapes.
# Only one shape can be the API, so a shape the API did not take is a loser
# in §9.4(5)'s sense and cannot be retained as a profile the way a §9.1 arm
# can.
CLASS=B
#
# `git worktree add <path> d802b9e4e8c9` restores every shape this row
# measured, which is what makes a re-ratification on a pinned host still
# possible.
REMOVED=retired
ADR=6
TITLE="Publish options: value tokens, functional closures, config struct, compiled (B5)"
# The four shapes build four option forms from the same abstract settings and
# must resolve to the same option set with the same errors (TestModel against
# Resolve), and each then publishes with what it resolved, so a shape cannot
# satisfy the oracle with a resolution nothing reads.
#
# allocs/op is the headline and TestAllocs pins it: the closure shape costs
# 1+n — one per captured option, plus one for the resolved set itself, which
# escapes to the heap because a func(*Resolved) hands its address to a
# function the compiler cannot see — and the other three cost zero at every n.
# The compiled arm's number is a publish-time number: its call site resolves
# and validates once, OUTSIDE the timed body, which is what CompileOptions is
# for and is NOT the same work its three siblings do inside theirs. The
# excluded half is measured separately —
# BenchmarkAPI/Options/<kind>/construct/n=<n> and construct.n<n>.allocs, one
# function for all four shapes: 3 allocations and ~350 ns for the compiled
# arm against 1 for the others — so A24 can compute the break-even instead of
# geomeaning four arms that do different work (adr/ADR-017-assumptions.md,
# assumption A23.19).
#
# The misuse column is where they separate on safety: the closure shape cannot
# check that an option wrote the field it declared (§4.9 silently violated) and
# the config struct cannot distinguish "unset" from "set to zero" without a
# set mask, which is the cost it pays for the same contract.

#
# CRITERION is the benchmark configuration's decision column for this row, quoted.
# MATRIX is the IQMQ_BENCH_MATRIX grid the campaign measures the family at.
# DECIDED_AT names the benchmark-name segments the criterion is read at, and
# DECIDED_ON the metrics; `make bench-lint` lists the family's benchmarks at
# the declared grid and fails when a term or a metric is missing from the rows
# every kind has in common, which is the only data `bakeoff decide` reads.
CRITERION="value tokens + typed structs + compiled (allocs at Publish(ctx, m, Delay(d)); construction cost; hot-loop overhead)"
# MATRIX=default is the only grid: x/apibench/b5 has no IQMQ_BENCH_MATRIX
# branch. Its six rows per kind are the call site and the construction at
# zero, one and six options, which is what assumption A23.19 requires so that
# the compiled arm's publish-time cost is visible beside its call site.
MATRIX=default
DECIDED_AT="n=0 n=1 n=6 construct"
DECIDED_ON="ns/op allocs/op"
