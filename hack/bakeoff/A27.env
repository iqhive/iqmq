# Family A27: topic registry kinds (internal/registry). See hack/bakeoff.sh.
PKG=./internal/registry
BENCH=BenchmarkRegistry
REF=rwmutexmap
AUTO_KEY=registry
ADR=14
TITLE="Topic registry (A27)"
# Full profile: IQMQ_BENCH_MATRIX=full sweeps P=1,4,8,32 goroutines.

#
# CRITERION is the benchmark configuration's decision column for this row, quoted.
# MATRIX is the IQMQ_BENCH_MATRIX grid the campaign measures the family at.
# DECIDED_AT names the benchmark-name segments the criterion is read at, and
# DECIDED_ON the metrics; `make bench-lint` lists the family's benchmarks at
# the declared grid and fails when a term or a metric is missing from the rows
# every kind has in common, which is the only data `bakeoff decide` reads.
CRITERION="read-heavy vs churn workloads -> sharded/COW expected"
# MATRIX=default because the criterion is read on the WORKLOAD axis, and the
# default grid produces all three workloads (read-heavy, churn and the mixed
# one between them) at P=1 and P=4. `full` doubles the family to add P=8 and
# P=32, which the criterion does not name -- the harness already sweeps
# GOMAXPROCS=1,4,8,32 on every row.
MATRIX=default
DECIDED_AT="readheavy churn mixed P=1 P=4"
DECIDED_ON="ns/op allocs/op"
