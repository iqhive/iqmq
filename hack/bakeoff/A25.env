# Family A25: handler deadline derivation (internal/leasectx).
# See hack/bakeoff.sh.
PKG=./internal/leasectx
BENCH=BenchmarkRun/Deadline
REF=withtimeout
AUTO_KEY=leasectx
ADR=17
TITLE="Handler deadline derivation (A25)"
# The deciding metric is timers/op alongside ns/op: the reference arms one
# runtime timer per delivery, the candidate one per scheduler wake.

#
# CRITERION is the benchmark configuration's decision column for this row, quoted.
# MATRIX is the IQMQ_BENCH_MATRIX grid the campaign measures the family at.
# DECIDED_AT names the benchmark-name segments the criterion is read at, and
# DECIDED_ON the metrics; `make bench-lint` lists the family's benchmarks at
# the declared grid and fails when a term or a metric is missing from the rows
# every kind has in common, which is the only data `bakeoff decide` reads.
CRITERION="Clock-based (allocs/op; timer count)"
# MATRIX=full because §10.4's batch ladder is 1/10/100/1000 and the smoke
# grid takes only the two ends: the criterion is per-delivery allocations and
# timers, and how they amortise over a fetch is the whole point of the
# `Clock`-based arm. The family is eight rows either way -- five minutes --
# so the fuller ladder is free.
MATRIX=full
DECIDED_AT="batch=1 batch=10 batch=100 batch=1000"
DECIDED_ON="allocs/op timers/op"
