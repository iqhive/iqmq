# Family A14: Kafka offset trackers (driverkit/offset). See hack/bakeoff.sh.
PKG=./driverkit/offset
BENCH=BenchmarkKafkaOffsetTracker
REF=mapscan
AUTO_KEY=offset
ADR=19
TITLE="Kafka offset tracker (A14)"
# The bounded-memory half of the §9 criterion is the B/pending metric the
# widewindow case reports; sequential is the budgeted case (≤ 20 ns, 0 allocs).

#
# CRITERION is the benchmark configuration's decision column for this row, quoted.
# MATRIX is the IQMQ_BENCH_MATRIX grid the campaign measures the family at.
# DECIDED_AT names the benchmark-name segments the criterion is read at, and
# DECIDED_ON the metrics; `make bench-lint` lists the family's benchmarks at
# the declared grid and fails when a term or a metric is missing from the rows
# every kind has in common, which is the only data `bakeoff decide` reads.
CRITERION="<= 20 ns ack, bounded memory -> bitset (segmented for wide gaps)"
# MATRIX=default is the only grid: driverkit/offset has no
# IQMQ_BENCH_MATRIX branch and its four rows per kind are §9.1's own
# {sequential,random,gaps,wide-window}.
MATRIX=default
DECIDED_AT="sequential random gaps widewindow"
DECIDED_ON="ns/op B/pending"
