# Family A20: JSON codec implementation (codec). See hack/bakeoff.sh.
PKG=./codec
BENCH=BenchmarkCodec/JSON
REF=json
AUTO_KEY=codec
# A24 assigns A20 to ADR-018, alongside the other encoding rows (A18, A19,
# A21): the plan's A24 row names no ADR for it, and the only other candidate --
# ADR-013 -- is not decided until Part B, after the Phase-0 exit this row
# belongs to (adr/ADR-017-assumptions.md).
ADR=18
TITLE="JSON codec implementation: encoding/json vs encoding/json/v2 (A20)"
# Only the JSON kinds are candidates, so the benchmark root is
# BenchmarkCodec/JSON: the pass-through codec (BenchmarkCodec/raw) and the
# content-type machinery (BenchmarkCodec/{Registry,ContentType}) are measured
# in the same file but take no part in the decision.
#
# encoding/json/v2 exists only from Go 1.27, so a bake-off run on an older
# toolchain sees one kind and must not bind Auto.
#
# REQUIRES_GO says the same to `make bench-lint`. Without it the lint, run on
# Go 1.26 by the CI job that takes its version from go.mod, reported "0 of 1
# kinds are declared PARTIAL_KINDS, leaving nothing to compare" -- a defect in
# this declaration that was really a fact about the toolchain. On an older
# toolchain the family is checked as a declaration only, and the lint prints
# that it did so.
REQUIRES_GO=1.27

#
# CRITERION is the benchmark configuration's decision column for this row, quoted.
# MATRIX is the IQMQ_BENCH_MATRIX grid the campaign measures the family at.
# DECIDED_AT names the benchmark-name segments the criterion is read at, and
# DECIDED_ON the metrics; `make bench-lint` lists the family's benchmarks at
# the declared grid and fails when a term or a metric is missing from the rows
# every kind has in common, which is the only data `bakeoff decide` reads.
CRITERION="stdlib unless > 30% gain with zero-dep preserved"
# MATRIX=default is the only grid: ./codec has no IQMQ_BENCH_MATRIX branch
# and its nine rows per kind are §9.1's {small,medium,large} over the three
# operations a codec has.
MATRIX=default
DECIDED_AT="Marshal Unmarshal AppendMarshal 64B 1KiB 64KiB"
DECIDED_ON="ns/op allocs/op MB/s"
