# Family A5: key→lane hash functions (internal/hash). See hack/bakeoff.sh.
PKG=./internal/hash
BENCH=BenchmarkHash
REF=fnv1a
AUTO_KEY=hash
ADR=14
TITLE="Key-to-lane hash (A5)"
# The Kafka partitioner (KafkaPartition) is not a candidate: the Kafka driver
# needs it whatever the bake-off decides.

#
# CRITERION is the benchmark configuration's decision column for this row, quoted.
# MATRIX is the IQMQ_BENCH_MATRIX grid the campaign measures the family at.
# DECIDED_AT names the benchmark-name segments the criterion is read at, and
# DECIDED_ON the metrics; `make bench-lint` lists the family's benchmarks at
# the declared grid and fails when a term or a metric is missing from the rows
# every kind has in common, which is the only data `bakeoff decide` reads.
CRITERION="ns/op with acceptable distribution -> xxh3/wyhash"
# MATRIX=default is the only grid: internal/hash has no IQMQ_BENCH_MATRIX
# branch and its six rows per kind are §9.1's own {8,32,256B} crossed with the
# two key representations of row B3.
MATRIX=default
DECIDED_AT="8B 32B 256B entry=bytes entry=string"
DECIDED_ON="ns/op MB/s"
# The "acceptable distribution" half of the criterion is a test, not a
# metric: the chi-squared lane distribution and the collision corpora are in
# internal/hash's own tests, and the correctness gate hack/bakeoff.sh runs
# first is what enforces them. The two aggregate rows (BenchmarkHash/Lane,
# BenchmarkHash/KafkaPartition) belong to no kind, so no per-kind filter
# measures them and no scorecard carries them.
